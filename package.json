  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "postbuild": "react-snap",
    "test": "craco test",
    "eject": "react-scripts eject"
  },
  "reactSnap": {
    "source": "build",
    "include": [
      "/",
      "/services",
      "/consultancy",
      "/contact",
      "/privacy-policy",
      "/terms-of-service",
      "/refund-policy"
    ],
    "skipThirdPartyRequests": true,
    "inlineCss": false,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "react-snap": "^1.23.0",
    "tailwindcss": "^3.4.17"
  }
